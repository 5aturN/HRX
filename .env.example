# HRXWarehouse — пример окружения. НЕ коммитить заполненный .env!
# Скопировать:  cp .env.example .env   — и заполнить секреты.

# Токен Telegram-бота (пустой — бот просто не стартует, API работает).
BOT_TOKEN=

# База данных.
# Локально (SQLite):  sqlite+aiosqlite:///./hrx.db
# В проде через compose (PostgreSQL, собирается автоматически из POSTGRES_* ниже):
#   DATABASE_URL=postgresql+asyncpg://hrx:СЕКРЕТ@db:5432/hrx
DATABASE_URL=sqlite+aiosqlite:///./hrx.db

# 1 — разрешить запросы без Telegram-авторизации (только для локальной отладки!).
# В проде обязательно 0.
DEV_ALLOW_UNAUTH=0

# Каталоги (в compose переопределены на тома /srv/uploads и /srv/backups).
UPLOAD_DIR=./uploads
BACKUP_DIR=./backups
# Лимит загрузки одного файла, МБ.
MAX_UPLOAD_MB=10

# Уровень логов: DEBUG, INFO, WARNING, ERROR.
LOG_LEVEL=INFO

# PostgreSQL для docker-compose.yml (пароль — только через .env, не в git!).
POSTGRES_DB=hrx
POSTGRES_USER=hrx
POSTGRES_PASSWORD=ЗАПОЛНИТЬ_СЛУЧАЙНЫМ_ПАРОЛЕМ

# Домен для Caddyfile (авто-HTTPS). Локально: localhost.
DOMAIN=localhost
